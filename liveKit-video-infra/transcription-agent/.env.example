# Copy to /opt/patvero/transcriber/.env and keep that file mode 600.
TRANSCRIPTION_AGENT_IMAGE=patvero/transcriber:1.0.0

# The agent runs on the Patvero media host and reaches LiveKit over loopback.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must exactly match LIVEKIT_TRANSCRIPTION_AGENT_NAME in the Patvero API.
LIVEKIT_AGENT_NAME=patvero-transcriber

OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
